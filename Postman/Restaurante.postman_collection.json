        {
          "name": "Incluir cliente (gera CPF válido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente Postman\",\n  \"cpf\": \"{{cpfGerado}}\",\n  \"telefone\": \"11999998888\",\n  \"email\": \"postman@email.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function gerarCpf() {",
                  "  var n = [];",
                  "  for (var i = 0; i < 9; i++) n.push(Math.floor(Math.random() * 10));",
                  "  function dv(a) { var s = 0; for (var i = 0; i < a.length; i++) s += a[i] * (a.length + 1 - i); var r = (s * 10) % 11; return r === 10 ? 0 : r; }",
                  "  n.push(dv(n)); n.push(dv(n));",
                  "  return n.join('');",
                  "}",
                  "pm.collectionVariables.set('cpfGerado', gerarCpf());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('clienteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
